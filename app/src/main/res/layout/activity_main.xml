<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="40dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tagline"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <!-- Status -->
        <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_status"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <ImageView
                android:id="@+id/statusIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle"
                android:contentDescription="@null"
                android:padding="10dp"
                android:src="@drawable/ic_check" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <!-- Last forwarded call or message: shows at a glance that it works -->
                <TextView
                    android:id="@+id/statusLast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Missing permissions (hidden when all is fine) -->
        <TextView
            android:id="@+id/permissionsLabel"
            style="@style/SectionLabel"
            android:text="@string/section_fix" />

        <LinearLayout
            android:id="@+id/permissions"
            style="@style/Card" />

        <!-- Calls: grid of app icons, tap to toggle -->
        <TextView
            style="@style/SectionLabel"
            android:text="@string/section_calls_from" />

        <LinearLayout
            android:id="@+id/callsGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="10dp" />

        <!-- Important messages: grid of app icons + rules -->
        <TextView
            style="@style/SectionLabel"
            android:text="@string/section_messages_from" />

        <LinearLayout
            android:id="@+id/messages"
            style="@style/Card">

            <LinearLayout
                android:id="@+id/messagesGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp" />
        </LinearLayout>

        <!-- History, test, watch app setup: each on its own screen -->
        <LinearLayout
            android:id="@+id/more"
            style="@style/Card"
            android:layout_marginTop="24dp" />

        <!-- About: version, source code, author's site (opened in the browser: no internet permission needed) -->
        <TextView
            android:id="@+id/about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_secondary"
            android:textColorLink="@color/accent"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
